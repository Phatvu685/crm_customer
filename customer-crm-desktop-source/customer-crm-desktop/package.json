{
  "name": "customer-crm-desktop",
  "version": "1.0.0",
  "description": "\u1ee8ng d\u1ee5ng desktop (Electron) cho Qu\u1ea3n L\u00fd Kh\u00e1ch H\u00e0ng \u2014 V\u1ecb Nguy\u00ean Food. Ch\u1ec9 l\u00e0 v\u1ecf hi\u1ec3n th\u1ecb giao di\u1ec7n; to\u00e0n b\u1ed9 d\u1eef li\u1ec7u v\u1eabn n\u1eb1m \u1edf backend NestJS + PostgreSQL tr\u00ean cloud.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron . --no-sandbox",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vinguyenfood.customercrm",
    "productName": "Quan Ly Khach Hang",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "QuanLyKhachHang-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}