# Copy this file to .env and fill in real values before running locally

# PostgreSQL connection string (Neon, Render Postgres, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT secret used to sign tokens (generate a long random string)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

JWT_EXPIRES_IN="12h"

# Render sets PORT automatically. Local default:
PORT=3001

# Allowed CORS origins (comma separated). Production = URL frontend Render.
CORS_ORIGIN="http://localhost:3000"
