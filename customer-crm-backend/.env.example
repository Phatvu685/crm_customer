# Example environment variables for local testing and Render
# Copy this file to .env and fill real values before running or building the image

# Prisma / Postgres connection (example):
# DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DATABASE_URL="postgres://user:password@localhost:5432/crm_db"

# JWT for auth
JWT_SECRET="change_this_to_a_strong_secret"
JWT_EXPIRES_IN=12h

# CORS origin(s), comma separated
CORS_ORIGIN="http://localhost:3000"

# Port (app defaults to 3001 if unset)
PORT=3001
# ============================================================================
# BIẾN MÔI TRƯỜNG - copy file này thành ".env" rồi điền giá trị thật vào.
# File ".env" KHÔNG được commit lên git (đã có trong .gitignore).
# ============================================================================

# Chuỗi kết nối tới database Postgres trên Neon (xem hướng dẫn lấy ở README.md).
# Dạng: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_KaEqxbic7Cp2@ep-red-thunder-az9rzf6y-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Khóa bí mật dùng để ký JWT token (đăng nhập). Đặt 1 chuỗi ngẫu nhiên, dài, khó đoán.
# Có thể tạo nhanh bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="node -e "console.log(require('crypto').randomBytes(48).toString('hex'))""

# Thời gian sống của access token, ví dụ "12h", "7d"
JWT_EXPIRES_IN="12h"

# Cổng HTTP server sẽ lắng nghe
PORT=3001

# Danh sách domain frontend được phép gọi API (CORS), cách nhau bởi dấu phẩy
CORS_ORIGIN="http://localhost:3000"
